<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>MasterBuilderHeeler</AssemblyName>
    <RootNamespace>MasterBuilderHeeler</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.1</Version>
    <PackageWebsiteUrl>https://github.com/dreamwraith/Valheim-MasterBuilderHeeler</PackageWebsiteUrl>
    <PackageDescription>Precision building tools for Valheim: pitch, yaw, and roll rotation, grid snapping, piece nudging, ghost freeze, in-place piece moving, piece sampling, build camera, and build info panels.</PackageDescription>
    <Authors>DreamWraith</Authors>
    <Company>DreamWraith (https://github.com/dreamwraith)</Company>
    <Copyright>Copyright (c) 2026 DreamWraith</Copyright>
    <Description>$(PackageDescription)</Description>
    <PackageProjectUrl>https://github.com/dreamwraith/Valheim-MasterBuilderHeeler</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dreamwraith/Valheim-MasterBuilderHeeler</RepositoryUrl>
    <NexusModId>4730</NexusModId>
    <NexusFileId></NexusFileId>
  </PropertyGroup>

  <!-- Thunderstore dependencies written to manifest.json -->
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2360" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.30.2" />
    <ThunderstoreDependency Include="shudnal-ConditionalConfigSync-1.0.11" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ConditionalConfigSync">
      <HintPath Condition="Exists('$(BEPINEX_PATH)\plugins\shudnal-ConditionalConfigSync\ConditionalConfigSync.dll')">$(BEPINEX_PATH)\plugins\shudnal-ConditionalConfigSync\ConditionalConfigSync.dll</HintPath>
      <HintPath Condition="!Exists('$(BEPINEX_PATH)\plugins\shudnal-ConditionalConfigSync\ConditionalConfigSync.dll') and Exists('$(BEPINEX_PATH)\plugins\ConditionalConfigSync.dll')">$(BEPINEX_PATH)\plugins\ConditionalConfigSync.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)ModBuild.targets" />
</Project>
